{% set fields = Bake.filterFields(fields, schema, modelObject) %}
<div class="{{ action }} card card-primary card-outline">
    <div class="card-header d-flex align-items-center">
        <h2 class="card-title">
            <?= $this->Html->link('<i class="bi bi-caret-left-fill"></i>', $redirect ?? ['action' => 'index'], ['escape' => false]) ?>
            <?= __('{{ action|humanize }} {{ singularHumanName }}') ?>
        </h2>
        <div class="ms-auto d-flex gap-1">
            <?= $this->Html->link(
                __('List {{ pluralHumanName }}'),
                ['action' => 'index'],
                ['class' => 'btn btn-light']
            ) ?>
{% if 'edit' in action %}
            <?= $this->Html->link(
                __('View {{ singularHumanName }}'),
                ['action' => 'view', ${{ singularVar }}->{{ primaryKey[0] }}],
                ['class' => 'btn btn-info']
            ) ?>
{% endif %}
        </div>
    </div>

{% if 'edit' in action %}
    <?= $this->Form->create(${{ singularVar }}) ?>
{% else %}
    <?= $this->Form->create(${{ singularVar }}, ['valueSources' => ['query', 'context']]) ?>
{% endif %}
    <div class="card-body">
{% for field in fields %}
{%- if field not in primaryKey %}
{%- if keyFields[field] is defined %}
{%- set fieldData = Bake.columnData(field, schema) %}
{%- if fieldData.null %}
        <?= $this->Form->control('{{ field }}', ['options' => ${{ keyFields[field] }}, 'empty' => true, 'class' => 'form-control']) ?>
{% else %}
        <?= $this->Form->control('{{ field }}', ['options' => ${{ keyFields[field] }}, 'class' => 'form-control']) ?>
{% endif %}
{%- elseif field not in ['created', 'modified', 'updated'] %}
{%- set fieldData = Bake.columnData(field, schema) %}
{%- if fieldData.type in ['date', 'datetime', 'time'] and fieldData.null %}
        <?= $this->Form->control('{{ field }}', ['empty' => true]) ?>
{% elseif fieldData.type in ['boolean'] %}
        <?= $this->Form->control('{{ field }}', ['custom' => true]) ?>
{% else %}
        <?= $this->Form->control('{{ field }}') ?>
{% endif %}
{%- endif %}
{%- endif %}
{%- endfor %}

{%- if associations.BelongsToMany is defined %}
{%- for assocName, assocData in associations.BelongsToMany %}
        <?= $this->Form->control('{{ assocData.property }}._ids', ['options' => ${{ assocData.variable }}]) ?>
{% endfor %}
{% endif %}
    </div>
    <div class="card-footer d-flex">
{% if 'edit' in action %}
        <div class="me-auto">
            <?= $this->Form->postLink(
                __('Delete {{ singularHumanName }}'),
                ['action' => 'delete', ${{ singularVar }}->{{ primaryKey[0] }}],
                [
                    'confirm' => __('Are you sure you want to delete # {0}?', ${{ singularVar }}->{{ primaryKey[0] }}),
                    'class' => 'btn btn-danger',
                ]
            ) ?>
        </div>
{% endif %}
        <div class="ms-auto d-flex gap-1">
            <?= $this->Form->button(__('Submit'), ['class' => 'btn btn-primary']) ?>
            <?= $this->Html->link(__('Cancel'), $redirect ?? ['action' => 'index'], ['class' => 'btn btn-secondary']) ?>
        </div>
    </div>
    <?= $this->Form->end() ?>
</div>