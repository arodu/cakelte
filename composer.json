{
  "name": "arodu/cakelte",
  "description": "CakeLTE: AdminLTE plugin for CakePHP 4.x",
  "type": "cakephp-plugin",
  "license": "MIT",
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "laminas/laminas-diactoros",
        "version": "2.26.0",
        "type": "library",
        "license": "BSD-3-Clause",
        "dist": {
          "url": "https://api.github.com/repos/laminas/laminas-diactoros/zipball/6584d44eb8e477e89d453313b858daac6183cddc",
          "type": "zip"
        },
        "require": {
          "php": ">=8.0",
          "psr/http-factory": "^1.0",
          "psr/http-message": "^1.1"
        },
        "provide": {
          "psr/http-factory-implementation": "1.0",
          "psr/http-message-implementation": "1.0"
        },
        "autoload": {
          "files": [
            "src/functions/create_uploaded_file.php",
            "src/functions/marshal_headers_from_sapi.php",
            "src/functions/marshal_method_from_sapi.php",
            "src/functions/marshal_protocol_version_from_sapi.php",
            "src/functions/marshal_uri_from_sapi.php",
            "src/functions/normalize_server.php",
            "src/functions/normalize_uploaded_files.php",
            "src/functions/parse_cookie_header.php",
            "src/functions/create_uploaded_file.legacy.php",
            "src/functions/marshal_headers_from_sapi.legacy.php",
            "src/functions/marshal_method_from_sapi.legacy.php",
            "src/functions/marshal_protocol_version_from_sapi.legacy.php",
            "src/functions/marshal_uri_from_sapi.legacy.php",
            "src/functions/normalize_server.legacy.php",
            "src/functions/normalize_uploaded_files.legacy.php",
            "src/functions/parse_cookie_header.legacy.php"
          ],
          "psr-4": {
            "Laminas\\Diactoros\\": "src/"
          }
        }
      }
    }
  ],
  "require": {
    "php": ">=8.1",
    "almasaeed2010/adminlte": "~3.2",
    "cakephp/cakephp": "^4.0",
    "friendsofcake/bootstrap-ui": "^3.0"
  },
  "require-dev": {
    "cakephp/cakephp-codesniffer": "^4.4",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "CakeLte\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CakeLte\\Test\\": "tests/",
      "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
    }
  },
  "scripts": {
    "check": [
      "@test",
      "@cs-check"
    ],
    "cs-check": "phpcs --colors -p",
    "cs-fix": "phpcbf --colors -p",
    "test": "phpunit --colors=always",
    "post-install-cmd": [
      "bin/cake cakelte install"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
