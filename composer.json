{
  "name": "arodu/cakelte",
  "description": "CakeLTE: AdminLTE plugin for CakePHP 4.x",
  "type": "cakephp-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "almasaeed2010/adminlte": "~3.2",
    "cakephp/cakephp": "^4.0",
    "friendsofcake/bootstrap-ui": "^3.0"
  },
  "require-dev": {
    "cakephp/cakephp-codesniffer": "^4.4",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "CakeLte\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CakeLte\\Test\\": "tests/",
      "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
    }
  },
  "scripts": {
    "check": [
      "@test",
      "@cs-check"
    ],
    "cs-check": "phpcs --colors -p",
    "cs-fix": "phpcbf --colors -p",
    "test": "phpunit --colors=always",
    "post-install-cmd": [
      "bin/cake cakelte install"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
